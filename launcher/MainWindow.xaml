<Window x:Class="NickisWorldLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fancy Five Launcher" 
        SizeToContent="WidthAndHeight"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Button Style für moderne abgerundete Buttons -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Einblende-Animation beim Start -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="#121212" CornerRadius="20" BorderBrush="#2A2A2A" BorderThickness="1" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="0" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Mods Container -->
                <RowDefinition Height="Auto"/> <!-- Progress -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header mit Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="FANCY FIVE" FontSize="28" FontWeight="ExtraBold" Foreground="#00A4EF"/>
                    <TextBlock x:Name="VersionText" Text="Version: Lädt..." Foreground="#555555" FontSize="12"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="–" Click="BtnMinimize_Click" Background="Transparent" Foreground="Gray" BorderThickness="0" Margin="0,0,10,0" FontSize="20"/>
                    <Button Content="✕" Click="BtnExit_Click" Background="Transparent" Foreground="Gray" BorderThickness="0" FontSize="16"/>
                </StackPanel>
            </Grid>

            <!-- Mod Auswahl (Clean Cards) -->
            <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="12" Padding="15">
                <StackPanel>
                    <TextBlock Text="KOMPONENTEN" Foreground="#444" FontWeight="Bold" FontSize="10" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2">
                        <CheckBox x:Name="CheckGrafik" Content="Grafikmod" Foreground="White" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="CheckSound" Content="SoundMod" Foreground="White" IsChecked="True" Margin="0,5"/>
                        <CheckBox x:Name="CheckSky" Content="Sky Addon" Foreground="White" Margin="0,5"/>
                        <CheckBox x:Name="CheckAurora" Content="Aurora Addon" Foreground="White" Margin="0,5"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Status & Progress -->
            <StackPanel Grid.Row="2" Margin="0,20">
                <TextBlock x:Name="StatusText" Text="System bereit" Foreground="#00A4EF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <ProgressBar x:Name="InstallProgress" Height="4" Foreground="#00A4EF" Background="#252525" BorderThickness="0" Visibility="Hidden"/>
            </StackPanel>

            <!-- Footer Actions -->
            <StackPanel Grid.Row="3">
                <UniformGrid Columns="2">
                    <Button Content="INSTALLIEREN" Click="BtnInstall_Click" Style="{StaticResource ModernButton}" Margin="0,0,5,0" Background="#00A4EF"/>
                    <Button Content="DEINSTALLIEREN" Click="BtnUninstall_Click" Style="{StaticResource ModernButton}" Margin="5,0,0,0" Background="#333333"/>
                </UniformGrid>
                
                <Button Content="FIVEM STARTEN" Click="BtnStartFiveM_Click" Style="{StaticResource ModernButton}" Background="#E15B00" Height="45" Margin="0,10,0,0" FontWeight="Bold">
                    <Button.Effect>
                        <DropShadowEffect Color="#E15B00" BlurRadius="10" Opacity="0.3" ShadowDepth="0"/>
                    </Button.Effect>
                </Button>

                <Grid Margin="0,15,0,0">
                    <CheckBox x:Name="AutostartCheck" Content="Mit Windows starten" Foreground="#555" FontSize="11" 
                              Checked="Autostart_Changed" Unchecked="Autostart_Changed" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Updates suchen" Click="BtnCheckUpdates_Click" Background="Transparent" Foreground="#444" BorderThickness="0" FontSize="11"/>
                        <TextBlock Text="|" Foreground="#222" Margin="5,0"/>
                        <Button Content="Hintergrund" Click="BtnHide_Click" Background="Transparent" Foreground="#444" BorderThickness="0" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
    </Grid>
    </Border>
</Window>