<Window x:Class="NickisWorldLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nicki's World Launcher" Height="350" Width="500" Background="#1E1E1E">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Nicki's World Grafik Mod" FontSize="24" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock x:Name="VersionText" Text="Version: Lädt..." Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <ProgressBar x:Name="InstallProgress" Height="20" Margin="0,10" Visibility="Hidden"/>
            <TextBlock x:Name="StatusText" Text="Bereit" Foreground="White" HorizontalAlignment="Center" Margin="0,5"/>

            <Button Content="Mod Installieren / Aktualisieren" Click="BtnInstall_Click" Height="40" Margin="0,10" Background="#007ACC" Foreground="White" Cursor="Hand"/>
            
            <Separator Margin="0,10" Background="#333333"/>
            
            <CheckBox x:Name="AutostartCheck" Content="Mit Windows starten" Foreground="White" Checked="Autostart_Changed" Unchecked="Autostart_Changed" Margin="0,10"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <Button Content="FiveM Starten" Click="BtnStartFiveM_Click" Width="150" Height="30" Margin="5" Background="#E15B00" Foreground="White"/>
                <Button Content="Nach Updates suchen" Click="BtnCheckUpdates_Click" Width="150" Height="30" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>